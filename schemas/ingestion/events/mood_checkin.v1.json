{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindpeers.io/schemas/ingestion/events/mood_checkin.v1.json",
  "title": "mood_checkin payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["mood_score", "scale_min", "scale_max"],
  "properties": {
    "mood_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "scale_min": {
      "type": "number",
      "const": 0
    },
    "scale_max": {
      "type": "number",
      "const": 10
    },
    "prompt_id": {
      "type": "string",
      "maxLength": 64
    },
    "optional_note_present": {
      "type": "boolean",
      "default": false
    }
  }
}
