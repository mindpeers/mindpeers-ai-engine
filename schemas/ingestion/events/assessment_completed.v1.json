{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindpeers.io/schemas/ingestion/events/assessment_completed.v1.json",
  "title": "assessment_completed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrument", "instrument_version", "assessment_id"],
  "properties": {
    "instrument": {
      "type": "string",
      "enum": ["CORE-OM", "GAD-7", "PHQ-9", "PTSD", "ASRS"]
    },
    "instrument_version": { "type": "string", "maxLength": 16 },
    "assessment_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "total_score": { "type": "number", "minimum": 0 },
    "max_score": { "type": "number", "exclusiveMinimum": 0 },
    "normalized": { "type": "number", "minimum": 0, "maximum": 1 },
    "severity_band": { "type": "string", "maxLength": 32 },
    "subscales": {
      "type": "object",
      "properties": {
        "wellbeing": { "$ref": "#/$defs/subscale" },
        "problems": { "$ref": "#/$defs/subscale" },
        "functioning": { "$ref": "#/$defs/subscale" },
        "risk": { "$ref": "#/$defs/subscale" }
      },
      "additionalProperties": false
    },
    "supersedes_id": { "type": "string", "maxLength": 128 }
  },
  "$defs": {
    "subscale": {
      "type": "object",
      "required": ["raw", "normalized"],
      "properties": {
        "raw": { "type": "number" },
        "normalized": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "instrument": { "const": "CORE-OM" } } },
      "then": {
        "required": ["total_score", "max_score", "subscales"],
        "properties": {
          "subscales": {
            "required": ["wellbeing", "problems", "functioning", "risk"]
          }
        }
      }
    },
    {
      "if": { "properties": { "instrument": { "const": "GAD-7" } } },
      "then": {
        "required": ["total_score", "max_score", "normalized"]
      }
    }
  ]
}
